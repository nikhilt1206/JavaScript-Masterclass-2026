//slice() - returns a shallow copy (array) of[start,end]. Does not modify the orginal array.
let names = ['jatin','anu','rahul'];
console.log(names);
let result = names.slice(0,2); //index 2 is excluded
console.log(result);
console.log(names);

result = names.slice(-1);
console.log(result); //last index
result = names.slice(0); //if we pass 0 - will get the whole array copy (no slicing will happen)
console.log(result);

//splice() - removes, replaces, or inserts inplace. Return the removed items. Modifies original array.
let numbers = [10,20,30,40,50];
let result1 = numbers.splice(0,2);//remove operation
console.log(result1);
console.log(numbers);
//insertion - returns empty array
let ans = numbers.splice(0,0,44);
console.log(ans);
console.log(numbers);
//replace - returns removed number
let data = numbers.splice(0,1,100);
console.log(data);
console.log(numbers);

//map() - returns a new array, same length, each element transformed by the callback
let names1 = ['jatin','nikhil','rahul','raj'];
let result2 = names1.map(function(value){
    return value.toUpperCase();
});
console.log(result2);
console.log(names1);
let numbers1 = [10,30,44,55];
let result3 = numbers1.map((value)=>value/2);
console.log(result3);
console.log(numbers1);