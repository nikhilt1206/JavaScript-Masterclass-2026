//reduce() - reduces the array to a single value using accumulator
let data = [10,20,30,40];
// let sum = 0;
// for(let number of data){
//     sum = sum + number;
// }
// console.log(sum);
let result = data.reduce(function(accumulated,number){
    accumulated=accumulated+number;
    return accumulated
},0); //0 is default value of accumulated
console.log(result);
