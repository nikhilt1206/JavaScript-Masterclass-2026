//concat() - to merge 2 or more arrays together - new array gets created - original arrays will be intact
let a = [10,20,30];
let b = [20,30];
let c = [100];
let ans = a.concat(b,c);
console.log(ans);
console.log(a);
//using spread operator
console.log([...a,...b,...c]);

//foreach() - 
ans.forEach(function(value,index){
    console.log(`${index} == ${value}`);
})